# ──────────────────────────────────────────────────────────────
# OpenBrawl Website — Laravel
# Laravel PHP framework
# ──────────────────────────────────────────────────────────────

# ── PHP Artifacts ─────────────────────────────────────────────

# PHP cache
opcache/

# Composer
vendor/

# PHPDoc
api/
build/

# ── Laravel Specific ──────────────────────────────────────────

# Environment files
.env
.env.production
.env.local
.env.*.local

# Laravel storage
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/framework/testing/*
storage/framework/session/*
storage/framework/data/*
storage/app/*
storage/logs/*
!.gitkeep

# Symfony cache (used by Laravel)
bootstrap/cache/*.php
public/storage

# ── IDE & Editor Files ────────────────────────────────────────

*.iml
*.iws
*.ipr
*.suo
*.user
*.userosscache
*.sublime-project
*.sublime-workspace

# ── OS & System Files ─────────────────────────────────────────

.DS_Store
Thumbs.db
Desktop.ini
*~
*.swp
*.swo
*#

# ── Logs & Temporary Files ────────────────────────────────────

*.log
*.tmp
*.temp
*.cache
*.bak
*.old
*.orig
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Node.js (for frontend assets) ─────────────────────────────

node_modules/
public/js/*.js
public/css/*.css

# Package lock files (optional - uncomment if you want to share versions)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# ── Build Artifacts ───────────────────────────────────────────

public/hot
public/build/

# Mix manifest
public/mix-manifest.json

# Vite build output
public/build/.vite/

# ── Testing ───────────────────────────────────────────────────

.phpunit.result.cache
coverage/

# ── Docker ────────────────────────────────────────────────────

# Docker compose overrides
docker-compose.override.yml

# ── Database ──────────────────────────────────────────────────

*.sql
*.sqlite
*.sqlite3

# ── Explicitly Track These Files ──────────────────────────────

!.gitignore
!storage/logs/.gitkeep
!storage/framework/cache/.gitkeep
!storage/framework/sessions/.gitkeep
!storage/framework/views/.gitkeep
!storage/framework/testing/.gitkeep
!storage/framework/session/.gitkeep
!storage/framework/data/.gitkeep
!storage/app/.gitkeep
